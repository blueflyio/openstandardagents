{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openstandardagents.org/schemas/v0.5.1/agent.schema.json",
  "title": "OSSA v0.5.1 Agent Manifest Schema",
  "description": "Open Standard for Software Agents (OSSA) v0.5.1 - Extends v0.5.0 with Execution Economics, StateMesh, and Portable Context Packs.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "pattern": "^ossa/v(0\\.5(\\.[0-9]+(-[a-zA-Z0-9.]+)?)?|0\\.4(\\.[0-9]+(-[a-zA-Z0-9.]+)?)?|0\\.3(\\.[4-9]|\\.[0-9]+(-[a-zA-Z0-9.]+)?)?|0\\.2\\.[2-9](-dev)?|1)(\\.[0-9]+)?(-[a-zA-Z0-9.]+)?$",
      "description": "OSSA API version (v0.5.1 adds execution economics and statemesh)",
      "examples": [
        "ossa/v0.5.1",
        "ossa/v0.5.0",
        "ossa/v0.4",
        "ossa/v1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "Agent",
        "Role",
        "Task",
        "Workflow",
        "Flow",
        "ExecutionProfile",
        "ContextPack",
        "ReplayPacket"
      ],
      "description": "Resource type: Agent, Role, Task, Workflow, Flow, ExecutionProfile, ContextPack, or ReplayPacket"
    },
    "metadata": {
      "$ref": "#/definitions/Metadata"
    },
    "spec": {
      "description": "Specification varies based on kind"
    },
    "economics": {
      "$ref": "#/definitions/ExecutionEconomics",
      "description": "Execution economics layer governing token budgets, model classes, and cost/risk tradeoffs (v0.5.1)"
    },
    "security": {
      "$ref": "#/definitions/SecurityPosture",
      "description": "Security posture metadata defining threat model, capability requirements, sandboxing, and network access constraints"
    },
    "protocols": {
      "$ref": "#/definitions/ProtocolDeclarations",
      "description": "Protocol declarations for MCP, A2A, and ANP interoperability"
    },
    "token_efficiency": {
      "$ref": "#/definitions/TokenEfficiency",
      "description": "Token efficiency configuration for cost-optimized execution"
    },
    "cognition": {
      "$ref": "#/definitions/Cognition",
      "description": "Reasoning pattern, trace config, and governance for auditable cognition (v0.5.0)"
    },
    "governance": {
      "$ref": "#/definitions/Governance",
      "description": "Governance and authorization policies including Cedar pre-execution checks and compliance profiles"
    },
    "extensions": {
      "type": "object",
      "description": "Framework-specific extensions",
      "properties": {
        "agentscope": {
          "$ref": "#/definitions/AgentScopeExtension"
        },
        "statemesh": {
          "$ref": "#/definitions/StateMeshExtension"
        },
        "security": {
          "type": "object",
          "description": "Security extensions including inline authorization policies",
          "properties": {
            "cedar": {
              "$ref": "#/definitions/CedarPolicyExtension"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "runtime": {
      "description": "Runtime-specific capability bindings"
    },
    "composition": {
      "$ref": "#/definitions/WorkflowComposition",
      "description": "Workflow composition with sequential/parallel projection"
    }
  },
  "definitions": {
    "Metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 253,
          "description": "Resource identifier"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63,
          "description": "Logical grouping namespace"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "description": "Semantic version"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Human-readable description"
        },
        "uuid": {
          "type": "string",
          "format": "uuid",
          "description": "Optional UUID v4"
        },
        "status": {
          "type": "string",
          "enum": ["active", "deprecated", "revoked"],
          "default": "active"
        }
      }
    },
    "ExecutionEconomics": {
      "type": "object",
      "description": "Execution economics and token governance configuration",
      "properties": {
        "execution_profile": { "type": "string" },
        "token_class": {
          "type": "string",
          "enum": ["micro-audit", "fast-route", "balanced-work", "deep-reason", "long-context", "strict-structured", "human-gated"]
        },
        "compression_policy": {
          "type": "string",
          "enum": ["none", "extractive", "semantic-brief", "schema-projection", "evidence-only", "risk-first", "diff-only"]
        }
      }
    },
    "StateMeshExtension": {
      "type": "object",
      "description": "StateMesh extension for governed agent state exchange",
      "properties": {
        "emits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema": { "type": "string" },
              "ttl": { "type": "string" }
            }
          }
        },
        "consumes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema": { "type": "string" },
              "required_attestation": { "type": "boolean" }
            }
          }
        }
      }
    },
    "Cognition": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string", "enum": ["sequential", "tree_of_thought", "react", "plan_and_execute"] },
        "trace": { "type": "object" }
      }
    },
    "SecurityPosture": { "type": "object" },
    "ProtocolDeclarations": { "type": "object" },
    "TokenEfficiency": { "type": "object" },
    "Governance": { "type": "object" },
    "AgentScopeExtension": { "type": "object" },
    "CedarPolicyExtension": { "type": "object" },
    "WorkflowComposition": { "type": "object" }
  }
}
